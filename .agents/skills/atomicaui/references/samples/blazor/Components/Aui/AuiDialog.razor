@* Generated from the AtomicAUI class recipes by the kit (scripts/samples-build.mjs). Copy it into your app; change what it is given, never a class list (AUI-09). *@
<button type="button" class="aui-stateful aui-focus-color-info aui-focus-width-2 aui-button aui-frame aui-scale-default-sm aui-typography-typescale-default aui-shape-soft aui-color-solid-surface-alt aui-elevation-0" data-aui-dialog-open="@(Id)">@Opener</button>
<div data-aui-dialog-layers hidden>
<div role="presentation" data-aui-typeface="engineering" data-aui-typography="body" class="aui-dialog-backdrop">
</div>
<div role="presentation" class="aui-dialog-viewport">
<div id="@(Id)" role="dialog" tabindex="-1" data-aui-typeface="engineering" data-aui-typography="body" class="aui-dialog-popup aui-frame aui-scale-no-padding-sm aui-typography-typescale-default aui-shape-soft aui-color-solid-surface aui-elevation-4" aria-labelledby="@(Id)-title" aria-describedby="@(Id)-description">
  <h2 id="@(Id)-title" class="aui-dialog-title aui-frame aui-typography-typescale-default aui-color-solid-surface-alt aui-scale-default-sm">@Title<div class="aui-dialog-spacer">
</div>
    <button type="button" aria-label="Close" class="aui-dialog-close aui-stateful aui-focus-color-info aui-focus-width-2 aui-button aui-frame aui-scale-contained-sm aui-typography-typescale-default aui-shape-soft aui-color-text-surface-alt aui-elevation-0">
      <span aria-hidden="true" class="aui-contained-icon aui-icon-lh-l3 aui-bg-transparent aui-min-width-0 aui-min-height-0 aui-padding-inline-start-0 aui-padding-inline-end-0 aui-padding-block-start-0 aui-padding-block-end-0 aui-gap-0 aui-shape-soft">
        <i aria-hidden="true" class="aui-icon aui-icon-size-fallback-14 fa-duotone fa-xmark" data-aui-icon-family="fa-7-pro" data-aui-icon-style="duotone">
</i>
      </span>
    </button>
  </h2>
  <p id="@(Id)-description" class="aui-dialog-description aui-frame aui-typography-typescale-default aui-scale-default-sm">@Description</p>
@if (Fields.Count > 0)
{
  <div class="aui-dialog-body aui-frame aui-typography-typescale-default aui-scale-no-padding-sm">
    <div role="presentation" class="aui-view-scroll-area aui-frame aui-scale-default-sm aui-typography-typescale-default aui-shape-none aui-color-text-surface aui-elevation-0 aui-dialog-body-scroll" style="--aui-scrollbar-size: var(--p-px-8)">
      <div role="presentation" tabindex="-1" class="aui-view-scroll-area-viewport">
<div class="aui-view aui-frame aui-scale-no-padding-sm aui-typography-typescale-default aui-shape-none aui-color-text-surface aui-elevation-0 aui-gap-8 aui-width-fill aui-display-flex aui-flex-direction-column">
@for (var index = 0; index < Fields.Count; index++)
{
    <div class="aui-field aui-frame aui-scale-no-padding-sm aui-typography-typescale-default aui-shape-soft aui-color-text-surface aui-elevation-0">
      <label id="@(Id)-field-@index-label" for="@(Id)-field-@index" class="aui-field-label aui-frame aui-scale-no-padding-sm aui-typography-typescale-default aui-shape-none aui-color-text-surface">@Fields[index]</label>
      <div class="aui-stateful aui-focus-color-info aui-focus-width-2 aui-field-control aui-frame aui-scale-default-sm aui-typography-typescale-default aui-shape-soft aui-color-fixed-surface aui-frame--inset aui-elevation-0">
        <input id="@(Id)-field-@index" class="aui-stateful aui-focus-color-info aui-focus-width-2 aui-input aui-frame aui-scale-no-padding-sm aui-typography-typescale-default aui-shape-none aui-color-text-surface aui-elevation-0" value name="@Fields[index]" aria-labelledby="@(Id)-field-@index-label">
      </div>
    </div>
}
</div>
</div>
    </div>
  </div>
}
  <div data-align="end" class="aui-dialog-actions aui-frame aui-typography-typescale-default aui-scale-default-sm">
@for (var index = 0; index < Actions.Count; index++)
{
    var action = Actions[index];
    if (index == Actions.Count - 1)
    {
        <button data-aui-action="@action" @onclick="() => OnAction.InvokeAsync(action)" type="button" class="aui-dialog-button aui-stateful aui-focus-color-info aui-focus-width-2 aui-button aui-frame aui-scale-default-sm aui-typography-typescale-default aui-shape-soft aui-color-solid-secondary aui-elevation-0">@action</button>
    }
    else
    {
        <button data-aui-action="@action" @onclick="() => OnAction.InvokeAsync(action)" type="button" class="aui-dialog-button aui-stateful aui-focus-color-info aui-focus-width-2 aui-button aui-frame aui-scale-default-sm aui-typography-typescale-default aui-shape-soft aui-color-solid-surface-alt aui-elevation-0">@action</button>
    }
}
</div>
</div>
</div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string Opener { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Fields { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Actions { get; set; } = [];
    /// <summary>The footer button the user chose. The script closes the dialog; this tells the component which one it was.</summary>
    [Parameter] public EventCallback<string> OnAction { get; set; }
}
