@page
@model IndexModel
@{
    ViewData["Title"] = "Equipment loans";
}
<div class="page-header">
    <h1 style="font-size: 22px">Equipment loans</h1>
    <div class="btn-toolbar">
        <button type="button" class="btn btn-primary" id="new-loan">New loan</button>
        <button type="button" class="btn btn-danger" id="return-item" disabled>Return item</button>
    </div>
</div>

<form method="get" class="row-form card-body" id="search-form">
    <div class="form-group">
        <label for="q">Search</label>
        <input id="q" name="Q" type="text" class="form-control" placeholder="Item or borrower" value="@Model.Q" />
    </div>
    <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="Status" class="form-select">
            @foreach (var option in new[] { "All statuses", "Open", "Overdue", "Returned" })
            {
                <option value="@option" selected="@(option == Model.Status)">@option</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-secondary">Search</button>
</form>

<div class="alert alert-warning" role="alert">Two loans are overdue.</div>

<table class="table table-striped" id="loans">
    <thead>
        <tr><th>Item</th><th>Borrower</th><th>Due</th><th>Status</th></tr>
    </thead>
    <tbody>
        @foreach (var loan in Model.Rows)
        {
            <tr data-id="@loan.Id">
                <td>@loan.Item</td>
                <td>@loan.Borrower</td>
                <td>@loan.Due</td>
                <td><span class="badge @(loan.Status == "Open" ? "text-bg-info" : loan.Status == "Overdue" ? "text-bg-warning" : "text-bg-success")">@loan.Status</span></td>
            </tr>
        }
    </tbody>
</table>
<p class="text-muted" id="count">Showing @Model.Rows.Count of @Model.Total loans</p>

<h2 class="section-title">Loans per week</h2>
<div id="chart" class="tinychart"></div>

<div class="modal" id="return-dialog" role="dialog" aria-modal="true" aria-labelledby="return-title" style="display: none">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h4 class="modal-title" id="return-title">Return this item?</h4></div>
            <div class="modal-body"><p>The loan is closed and the item is back on the shelf.</p></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="return-cancel">Cancel</button>
                <button type="button" class="btn btn-primary" id="return-confirm">Return</button>
            </div>
        </div>
    </div>
</div>
